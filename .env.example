# Enterprise Employee Portal — Environment Variables
# Copy this file to .env and fill in your values.
# ⚠️ NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# MySQL Database (Local or Cloud)
# ---------------------------------------------------------------------------
# Option A: Individual credentials (Local Docker / Local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eep_db
DB_USER=eep_user
DB_PASSWORD=eep_secret_change_me
DB_ROOT_PASSWORD=root_secret_change_me
DB_SSL=false

# Option B: Connection URI (TiDB Cloud, Aiven, Railway, etc.)
# If DATABASE_URL is set, it overrides DB_HOST/DB_USER/DB_PASSWORD.
# DATABASE_URL=mysql://user:pass@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/eep_db?sslMode=VERIFY_IDENTITY

DB_SYNC=true
DB_SYNC_ALTER=true
DB_SEED=true

# ---------------------------------------------------------------------------
# JWT Authentication & Cookies
# ---------------------------------------------------------------------------
JWT_SECRET=change_this_to_a_very_long_random_string_in_production
JWT_EXPIRES_IN=8h
# Set to 'none' if FE and BE are on different domains without proxy, or 'lax' if using Vercel rewrite / same-domain
COOKIE_SAME_SITE=lax

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Allowed frontend origins (comma-separated if multiple, e.g. http://localhost:5173,https://my-app.vercel.app)
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Client (Vite)
# ---------------------------------------------------------------------------
# For local dev: http://localhost:3000/api
# For production on Vercel with vercel.json rewrite: /api
# For production direct backend call: https://your-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:3000/api

