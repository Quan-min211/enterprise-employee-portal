# .env.test — Dùng cho Vitest (backend smoke tests trên local)
# Không commit file này nếu chứa credentials thật.
# CI tự inject qua environment variables (xem .github/workflows/ci.yml).

NODE_ENV=test
PORT=3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eep_test
DB_USER=root
DB_PASSWORD=
DB_SYNC=true
DB_SYNC_ALTER=false
DB_SEED=false

JWT_SECRET=test-jwt-secret-minimum-32-chars-ok
JWT_EXPIRES_IN=1h
COOKIE_SAME_SITE=lax
CLIENT_URL=http://localhost:5173
