# Enterprise Employee Portal — Production Environment Variables
# Copy to .env.production (NOT committed to git) and fill in real values.
# ⚠️ KHÔNG COMMIT FILE NÀY SAU KHI ĐIỀN GIÁ TRỊ THẬT.

# ---------------------------------------------------------------------------
# MySQL Database — Production (TiDB Cloud / Aiven / Railway / VPS)
# ---------------------------------------------------------------------------
# Option A: Connection URI (recommended for cloud DB)
DATABASE_URL=mysql://user:STRONG_PASSWORD@your-db-host:3306/eep_production

# Option B: Individual credentials (nếu không dùng DATABASE_URL)
# DB_HOST=your-db-host.example.com
# DB_PORT=3306
# DB_NAME=eep_production
# DB_USER=eep_user
# DB_PASSWORD=STRONG_PASSWORD_HERE
# DB_SSL=true

# ĐẶT THÀNH false Ở PRODUCTION — dùng migration thay cho sync!
DB_SYNC=false
DB_SYNC_ALTER=false
# Không seed tài khoản mặc định ở production
DB_SEED=false

# ---------------------------------------------------------------------------
# JWT — dùng chuỗi ngẫu nhiên ≥ 64 ký tự
# Sinh: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_MINIMUM_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------------
# Cookie — 'none' nếu FE và BE khác domain, 'lax' nếu cùng domain hoặc dùng Vercel rewrite
# ---------------------------------------------------------------------------
COOKIE_SAME_SITE=none

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Allowed frontend origin(s) — URL thật của Vercel / hosting
# Nhiều domain: phân cách bằng dấu phẩy
CLIENT_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Vite — chỉ dùng ở client build time
# ---------------------------------------------------------------------------
# Đặt về /api nếu dùng Vercel rewrite (vercel.json), hoặc URL API thật
VITE_API_BASE_URL=https://your-backend.onrender.com/api
